# Backend settings for local development (copy to backend/.env).
# All values are optional; the defaults run fully offline with SQLite and demo data.
# PAPER TRADING ONLY — no setting enables live trading.

APP_ENV=development

# SQLite in development; PostgreSQL in production:
#   postgresql+psycopg://trading:trading@localhost:5432/trading_academy
DATABASE_URL=sqlite:///./trading_academy.db
# create tables on startup (development only; production runs `alembic upgrade head`)
AUTO_CREATE_TABLES=true
# assets, lessons, strategy templates and the demo user (idempotent)
SEED_DEMO_DATA=true

# Celery is optional. Without it backtests run as FastAPI background tasks and
# paper accounts / bots are synced whenever the user opens the app.
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=dev-insecure-secret-change-me
COOKIE_SECURE=false
SESSION_DAYS=30
CORS_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT_PER_MINUTE=20

# demo | binance (crypto) | twelvedata (needs key) — or a comma-separated chain such as
# "binance,twelvedata" (first provider that supports the instrument wins; no fallback on errors)
MARKET_DATA_CRYPTO=demo
MARKET_DATA_FX=demo
MARKET_DATA_STOCKS=demo
# empty = use the MARKET_DATA_STOCKS chain
MARKET_DATA_ETF=
MARKET_DATA_INDICES=
MARKET_DATA_COMMODITIES=
BINANCE_BASE_URL=https://data-api.binance.vision
TWELVEDATA_API_KEY=
# true only on a Twelve Data real-time plan (otherwise the data is labelled "delayed")
TWELVEDATA_REALTIME=false
FINNHUB_API_KEY=

# Instrument catalog discovery (read-only public reference lists → assets table).
# Run manually:  python -m app.market.discovery --provider binance|twelvedata|all [--kinds forex_pairs,commodities]
# true = Celery beat syncs daily (needs USE_CELERY=true and a beat process)
CATALOG_AUTO_SYNC=false
# Binance spot pairs are synced only for these quote assets
CATALOG_BINANCE_QUOTES=USDT,USDC,FDUSD,BTC,ETH,EUR
# Twelve Data stocks/ETFs are synced only for these countries (comma separated, Twelve Data names)
CATALOG_TWELVEDATA_COUNTRIES=United States

# offline | anthropic
AI_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_MAX_TOKENS=4000
AI_TIMEOUT_SECONDS=60
