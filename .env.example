# Trading Academy — environment for `docker compose up`.
# Copy to .env and adjust. Every value is optional: without a .env the stack starts
# with demo market data, the offline AI teacher and local-only credentials.
#
# PAPER TRADING ONLY. There is no setting that enables live trading, and the app
# never asks for exchange API keys, private keys, seed phrases or payment data.

# --- Ports on the host -------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Security ----------------------------------------------------------------
# Long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
# true when the site is served over HTTPS
COOKIE_SECURE=false
# comma separated origins allowed to call the API directly (the web app uses a same-origin proxy)
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading_academy

# --- Background jobs (Celery + Redis) -------------------------------------------
# true: backtests run in the worker; beat checks SL/TP of open paper positions and runs paper bots
USE_CELERY=true

# --- Market data (read-only) -----------------------------------------------------
# demo        deterministic synthetic data, labelled DEMO in the UI (works offline)
# binance     Binance public market-data endpoints, no key (crypto only)
# twelvedata  Twelve Data REST API, needs TWELVEDATA_API_KEY (fx, stocks, ETFs, indices, commodities)
# Each value may be a comma-separated chain, e.g. "binance,twelvedata": the first provider that
# SUPPORTS an instrument serves it. Instruments no provider supports show DATA NOT AVAILABLE
# (never invented numbers); provider errors are shown as errors, never replaced by demo data.
MARKET_DATA_CRYPTO=demo
MARKET_DATA_FX=demo
MARKET_DATA_STOCKS=demo
# empty = use the MARKET_DATA_STOCKS chain
MARKET_DATA_ETF=
MARKET_DATA_INDICES=
MARKET_DATA_COMMODITIES=
TWELVEDATA_API_KEY=
# true only on a Twelve Data real-time plan (otherwise the data is labelled "delayed")
TWELVEDATA_REALTIME=false
# optional economic/news headlines (never used as a trading signal)
FINNHUB_API_KEY=

# --- Instrument catalog discovery ------------------------------------------------------
# Synced instruments come from read-only public reference lists (no keys) and have no demo data:
# they show DATA NOT AVAILABLE unless a real provider above serves them.
# Run once:  docker compose exec backend python -m app.market.discovery --provider all
# true = sync daily in Celery beat (needs USE_CELERY=true)
CATALOG_AUTO_SYNC=false
CATALOG_BINANCE_QUOTES=USDT,USDC,FDUSD,BTC,ETH,EUR
CATALOG_TWELVEDATA_COUNTRIES=United States

# --- AI teacher --------------------------------------------------------------------
# offline    rule-based teacher, no key needed
# anthropic  Claude via the official Anthropic SDK
AI_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — higher = deeper explanations, slower and more expensive
AI_EFFORT=low
